# Never commit the real key. Put this in backend/.env or your cloud host's secret store.
BACKBOARD_API_KEY=
BACKBOARD_PROVIDER=openrouter
# Confirm this identifier is in YOUR Backboard model catalog before live calls.
BACKBOARD_MODEL=qwen/qwen3-8b
# Comma-separated allowed browser origins (no '*' for production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787
# Required when publishing an accessible backend: prevents strangers from spending your Backboard credits.
API_ACCESS_CODE=
# Set true only during local diagnosis. Responses expose only a static failure category.
BACKBOARD_DIAGNOSTICS=false
